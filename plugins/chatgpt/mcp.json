{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "terminologia": {
      "type": "streamable-http",
      "url": "https://api.voa.health/mcp/terminology/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {"mode": "cimd"},
            "baseScopes": ["voa:terminology:read"]
          }
        }
      }
    }
  }
}
